BASE_PATH=/woicrew
FRONTEND_ORIGIN=https://crew.ambilight.com
DATABASE_URL=sqlite+aiosqlite:///./dev.db
SESSION_SECRET=change-me-session-secret-min-32-chars-long-please
JWT_SECRET=change-me-jwt-secret-min-32-chars-long-please!!
JWT_ALGORITHM=HS256
# Access JWT lifetime from issuance (not idle/sliding). Client should refresh before exp.
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Grace window (seconds) for accepting an already-rotated refresh token, to
# tolerate concurrent/lagging refreshes from the same client.
REFRESH_GRACE_SECONDS=60
SKIP_AUTH=0
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Device domain (002-device-manage)
DATABASE_URL_DEVICES=sqlite+aiosqlite:///./devices_dev.db
REDIS_URL=redis://127.0.0.1:6379/0
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
GEOIP_MMDB_PATH=
OFFLINE_THRESHOLD_MINUTES=15

# Skill hub (003-skill-hub)
SKILL_STORAGE_ROOT=./storage/skills
SKILL_DOWNLOAD_TOKEN_TTL_SECONDS=300
SKILL_MAX_UPLOAD_MB=50

# Proxy usage analytics (Elasticsearch)
ES_NODE=http://127.0.0.1:9200
ES_INDEX=woicrew-usage
# CrewProxy connection (model permission management)
CREW_PROXY_URL=http://localhost:3456
CREW_PROXY_API_KEY=Ambilight@IT001

# Windows AD authentication (006-ad-auth)
# 填入真实 AD 信息后将 AD_AUTH_ENABLED 改为 1；生产环境务必用 ldaps:// 且 AD_TLS_ENABLED=1。
AD_AUTH_ENABLED=1
AD_URL=ldap://10.1.1.10:389
AD_BASE_DN=OU=Users,OU=ambilight,DC=ambilight,DC=cc
AD_GROUP_BASE_DN=OU=Group,DC=ambilight,DC=cc
AD_BIND_DN=CN=ldap,OU=信息技术部,OU=人力行政中心,OU=Users,OU=ambilight,DC=ambilight,DC=cc
AD_BIND_PASSWORD=ABCabc123
AD_USER_SEARCH_FILTER=(sAMAccountName={account})
AD_TLS_ENABLED=0
AD_ATTR_EMAIL=mail
AD_ATTR_DISPLAY_NAME=displayName
AD_ATTR_DEPARTMENT=department
AD_ATTR_TITLE=title
AD_CONNECT_TIMEOUT_SECONDS=5
AD_PAGE_SIZE=500