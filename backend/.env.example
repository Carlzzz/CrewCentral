BASE_PATH=/woicrew
FRONTEND_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=sqlite+aiosqlite:///./dev.db
SESSION_SECRET=change-me-session-secret-min-32-chars-long-please
JWT_SECRET=change-me-jwt-secret-min-32-chars-long-please!!
JWT_ALGORITHM=HS256
# Access JWT lifetime from issuance (not idle/sliding). Client should refresh before exp.
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Grace window (seconds) for accepting an already-rotated refresh token, to
# tolerate concurrent/lagging refreshes from the same client.
REFRESH_GRACE_SECONDS=60
SKIP_AUTH=1
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Device domain (002-device-manage)
DATABASE_URL_DEVICES=sqlite+aiosqlite:///./devices_dev.db
REDIS_URL=
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
GEOIP_MMDB_PATH=
OFFLINE_THRESHOLD_MINUTES=15

# Skill hub (003-skill-hub)
SKILL_STORAGE_ROOT=./storage/skills
SKILL_DOWNLOAD_TOKEN_TTL_SECONDS=300
SKILL_MAX_UPLOAD_MB=50

# Proxy usage analytics (Elasticsearch)
ES_NODE=http://127.0.0.1:9200
ES_INDEX=woicrew-usage

# CrewProxy connection (model permission management)
CREW_PROXY_URL=http://localhost:3456
CREW_PROXY_API_KEY=Ambilight@IT001

# Windows AD authentication (006-ad-auth)
# Set AD_AUTH_ENABLED=1 to show the AD login entry and enable the endpoints.
AD_AUTH_ENABLED=0
# ldap:// for plaintext (dev only) or ldaps:// for TLS (production).
AD_URL=ldap://dc.example.com:389
AD_BASE_DN=DC=example,DC=com
# Optional: where the admin UI loads AD groups from. Leave blank to search the domain root inferred from AD_BASE_DN.
AD_GROUP_BASE_DN=OU=Group,DC=example,DC=com
# Service account used to search for user entries.
AD_BIND_DN=CN=svc-crew,OU=Service,DC=example,DC=com
AD_BIND_PASSWORD=change-me-service-account-password
# {account} is replaced with the escaped sAMAccountName at login time.
AD_USER_SEARCH_FILTER=(sAMAccountName={account})
# MUST be 1 in production (LDAPS or StartTLS).
AD_TLS_ENABLED=0
# AD attribute -> local User field mapping.
AD_ATTR_EMAIL=mail
AD_ATTR_DISPLAY_NAME=displayName
AD_ATTR_DEPARTMENT=department
AD_ATTR_TITLE=title
# Connect/bind timeout so an unreachable AD fails fast (SC-003).
AD_CONNECT_TIMEOUT_SECONDS=5
# Paged-search page size for batch sync (AD default max is 1000).
AD_PAGE_SIZE=500
